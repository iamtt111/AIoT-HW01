# CWA Open Data API credential. Set this as a GitHub Actions repository secret.
CWA_API_KEY=

# Supabase server-side API access for Next.js route handlers. Never expose this key to browsers.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# PostgreSQL connection string for ingestion only (GitHub Actions/local CLI).
# Never expose this to Vercel client code or commit its real value.
SUPABASE_DB_URL=

# Optional deployment / workflow secrets. Set their real values in the provider,
# not in this file.
VERCEL_DEPLOY_HOOK_URL=
GITHUB_ACTIONS_SYNC_TOKEN=
