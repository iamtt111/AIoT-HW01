# CWA Open Data API credential. Set this as a GitHub Actions repository secret.
CWA_API_KEY=

# Supabase server-side API access for Next.js route handlers. Never expose this key to browsers.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# PostgreSQL connection string for ingestion only (GitHub Actions/local CLI).
# Never expose this to Vercel client code or commit its real value.
SUPABASE_DB_URL=

# Protected administrator settings. Set these only in web/.env.local and Vercel.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Vercel-only GitHub Actions dispatch configuration. The fine-grained token needs
# Actions: Read and write for this repository; never expose it to the browser.
GITHUB_ACTIONS_SYNC_TOKEN=
GITHUB_REPOSITORY=<owner>/<repository>
GITHUB_SYNC_REF=main
